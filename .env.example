# =============================================
# ARISA Cloud Backend — Environment Variables
# =============================================
# Copy this file to .env and fill in your values.

# Application
PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://rwwrdxaggybieemgzszu.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret

# Database
# For local Docker: postgresql://arisa:arisa_dev_password@localhost:5432/arisa?schema=public
# For Supabase: get from Supabase dashboard → Settings → Database
DATABASE_URL=postgresql://postgres.rwwrdxaggybieemgzszu:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection for migrations (port 5432, NOT pooler)
DIRECT_URL=postgresql://postgres.rwwrdxaggybieemgzszu:your_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DEVICE_TOKEN_SALT_ROUNDS=12

# Pairing
PAIRING_CODE_EXPIRY_MINUTES=10

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# OpenRouter AI
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_MAX_TOKENS=8192
OPENROUTER_TIMEOUT_MS=30000
AI_USER_RATE_LIMIT_PER_MINUTE=10
AI_USER_RATE_LIMIT_PER_HOUR=100
